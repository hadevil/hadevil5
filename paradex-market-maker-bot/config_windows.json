{
    "trading": {
        "order_value_usd": {
            "min": 8,
            "max": 25
        },
        "order_duration_min": {
            "min": 10,
            "max": 25
        },
        "delay_between_orders_min": {
            "min": 1,
            "max": 5
        },
        "max_leverage": 1.2,
        "max_position_ltv": 75,
        "orders_distribution_noise": 0.08,
        "retries": 3,
        "price_tolerance_pct": 0.1,
        "min_order_size": 0.001,
        "max_slippage_pct": 0.5
    },
    "risk_management": {
        "max_positions_per_cycle": 2,
        "stop_loss_percentage": 3,
        "take_profit_percentage": 1.5,
        "max_daily_volume_usd": 800,
        "max_loss_per_day_usd": 50,
        "max_consecutive_losses": 5,
        "circuit_breaker_enabled": true,
        "emergency_stop_loss_pct": 5,
        "cooldown_after_loss_min": 10
    },
    "pairs": {
        "primary_pairs": ["SOL-USD"],
        "fallback_pairs": ["ETH-USD", "BTC-USD"],
        "min_volume_usd": 5000,
        "focus_on_sol": true,
        "enable_rotation": false,
        "rotation_interval_min": 60
    },
    "market_data": {
        "update_interval_sec": 30,
        "cache_duration_sec": 60,
        "fallback_to_simulation": true,
        "volatility_threshold": 0.02
    },
    "logging": {
        "level": "INFO",
        "file": "logs/trading.log",
        "max_size_mb": 10,
        "backup_count": 5,
        "windows_compatible": true,
        "enable_console_colors": true,
        "log_trades_to_file": true,
        "log_performance_metrics": true
    },
    "monitoring": {
        "enable_health_check": true,
        "health_check_interval_min": 5,
        "alert_on_high_cpu": true,
        "alert_on_memory_usage": true,
        "max_memory_usage_mb": 200,
        "max_cpu_usage_pct": 80
    },
    "notifications": {
        "enable_telegram": false,
        "telegram_token": "",
        "telegram_chat_id": "",
        "notify_on_trade": false,
        "notify_on_error": true,
        "notify_on_daily_summary": true
    },
    "debug": false,
    "windows_optimizations": {
        "use_asyncio": false,
        "memory_limit_mb": 150,
        "cpu_priority": "normal",
        "enable_process_priority": true,
        "optimize_for_ssd": true
    },
    "backup": {
        "enable_auto_backup": true,
        "backup_interval_hours": 6,
        "backup_retention_days": 7,
        "backup_location": "backups/",
        "include_logs": false,
        "include_metrics": true
    },
    "advanced": {
        "enable_ml_predictions": false,
        "ml_model_path": "models/",
        "use_historical_data": true,
        "prediction_horizon_min": 15,
        "confidence_threshold": 0.7
    }
}